t;/X&gt;\n                                  &lt;Y&gt;369&lt;/Y&gt;\n                                &lt;/item&gt;\n                                &lt;item name="Selected" type_name="gh_bool" type_code="1"&gt;true&lt;/item&gt;\n                              &lt;/items&gt;\n                            &lt;/chunk&gt;\n                          &lt;/chunks&gt;\n                        &lt;/chunk&gt;\n                        &lt;chunk name="InputParam" index="7"&gt;\n                          &lt;items count="8"&gt;\n                            &lt;item name="Access" type_name="gh_int32" type_code="3"&gt;2&lt;/item&gt;\n                            &lt;item name="Description" type_name="gh_string" type_code="10"&gt;A wire relay object&lt;/item&gt;\n                            &lt;item name="InstanceGuid" type_name="gh_guid" type_code="9"&gt;24cf07eb-6a89-4660-8bba-03fa757e6afb&lt;/item&gt;\n                            &lt;item name="Name" type_name="gh_string" type_code="10"&gt;Relay&lt;/item&gt;\n                            &lt;item name="NickName" type_name="gh_string" type_code="10"&gt;Anchor Depth 4&lt;/item&gt;\n                            &lt;item name="Optional" type_name="gh_bool" type_code="1"&gt;true&lt;/item&gt;\n                            &lt;item name="SourceCount" type_name="gh_int32" type_code="3"&gt;1&lt;/item&gt;\n                            &lt;item name="Source" type_name="gh_guid" type_code="9" index="0"&gt;5b50d893-e3d3-4a05-ad2a-117c017909b7&lt;/item&gt;\n                          &lt;/items&gt;\n                          &lt;chunks count="1"&gt;\n                            &lt;chunk name="Attributes"&gt;\n                              &lt;items count="3"&gt;\n                                &lt;item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35"&gt;\n                                  &lt;X&gt;433&lt;/X&gt;\n                                  &lt;Y&gt;379&lt;/Y&gt;\n                                  &lt;W&gt;132&lt;/W&gt;\n         