  &lt;Y&gt;239&lt;/Y&gt;\n                                  &lt;W&gt;62&lt;/W&gt;\n                                  &lt;H&gt;160&lt;/H&gt;\n                                &lt;/item&gt;\n                                &lt;item name="Pivot" type_name="gh_drawing_pointf" type_code="31"&gt;\n                                  &lt;X&gt;626&lt;/X&gt;\n                                  &lt;Y&gt;319&lt;/Y&gt;\n                                &lt;/item&gt;\n                                &lt;item name="Selected" type_name="gh_bool" type_code="1"&gt;true&lt;/item&gt;\n                              &lt;/items&gt;\n                            &lt;/chunk&gt;\n                          &lt;/chunks&gt;\n                        &lt;/chunk&gt;\n                      &lt;/chunks&gt;\n                    &lt;/chunk&gt;\n                  &lt;/chunks&gt;\n                &lt;/chunk&gt;\n              &lt;/chunks&gt;\n            &lt;/chunk&gt;\n            &lt;/chunks&gt;\n        &lt;/chunk&gt;\n      &lt;/chunks&gt;\n    &lt;/chunk&gt;\n  &lt;/chunks&gt;\n&lt;/Archive&gt;'
SLIDER_IDS=['3fe12075-90bc-4039-8d6d-99890d90a191', '1f0c82f2-40df-4e7e-ac77-fb34c44228d1', 'bb095ede-a480-46fb-8587-9d95ded31b21', 'b278264b-378b-4b09-ad96-381de877599c', '1c957901-4164-42b7-bd79-9859c4cf1b92', '913073c9-4d2e-45f2-9d05-5531e2908c43', 'f3a4ca31-2abd-4717-bf2b-a6f0fb62bc5f', '5b50d893-e3d3-4a05-ad2a-117c017909b7']
# Python 2.7 / 3 compatible; embedded in the Grasshopper document.
import hashlib
import csv

FIELDS = ['Radius','Depth','Openings','Height','Layer1','Layer2','Layer3','Layer4','Yaw','OffsetX','OffsetY','Gap','Enabled']

def support_id(mode, x, y, yaw):
    key = '%d|%.6f|%.6f|%.6f' % (mode,x,y,yaw)
    return 'S-' + hashlib.sha256(key.encode('ascii')).hexdigest()[:12]

def read_overrides(lines):
    result = {}
    for block in lines or []:
        for line in str(block).splitlines():
            if not line.strip() or line.lstrip().startswith('#'): continue
            cells = next(csv.reader([line]))
            cells = [v.strip() for v in cells]
            if cells[0].lower() == 'id': continue
            if len(cells)==15: cells=cells[:14]
            if len(cells) != 14: raise ValueError('Each override row needs ID + 13 fields; blank means default.')
            ident = cells[0]
            if not ident.startswith('S-'): raise ValueError('Copy an ID from the Catalog output: '+ident)
            if ident in result: raise ValueError('Duplicate support ID: '+ident)
            values = [None if not s else float(s) for s in cells[1:]]
            if any(v is not None and (math.isnan(v) or math.isinf(v)) for v in values): raise ValueError('Non-finite parameter: '+ident)
            result[ident] = values
    return result

def resolve_params(defaults, override):
    values = list(defaults)
    if override:
        values = [a if b is None else b for a,b in zip(values,override)]
    if any(v &lt;= 0 for v in values[:8]): raise ValueError('All eight generator parameters must be positive')
    bounds=[(1,100),(0.5,100),(3,30),(1,200)]+[(0.1,10)]*4
    if any(not lo&lt;=v&lt;=hi for v,(lo,hi) in zip(values[:8],bounds)): raise ValueError('Generator parameter outside original slider range')
    if values[2] != int(values[2]) or not 3 &lt;= values[2] &lt;= 30: raise ValueError('Openings must be an integer from 3 to 30')
    if values[11] &lt; 0: raise ValueError('Gap must be nonnegative')
    if values[12] not in (0,1): raise ValueError('Enabled must be 0 or 1')
    return values

def rectangles_overlap(a,b):
    # Separating axis test for two rotated padded rectangles.
    for poly in (a,b):
        for i in (0,1):
            vx=poly[i+1].X-poly[i].X; vy=poly[i+1].Y-poly[i].Y
            pa=[-vy*p.X+vx*p.Y for p in a[:4]]
            pb=[-vy*p.X+vx*p.Y for p in b[:4]]
            if max(pa)&lt;=min(pb)+1e-8 or max(pb)&lt;=min(pa)+1e-8: return False
    return True

def create_generator():
    import Grasshopper as GH
    import clr
    clr.AddReference('GH_IO')
    import GH_IO
    from System import Decimal
    archive=GH_IO.Serialization.GH_Archive()
    if not archive.Deserialize_Xml(SUPPORT_XML): raise ValueError('Embedded generator archive failed to load')
    document=GH.Kernel.GH_Document()
    if not archive.ExtractObject(document,'Definition'): raise ValueError('Embedded generator extraction failed')
    document.Enabled=True
    sliders={str(o.InstanceGuid):o for o in document.Objects if isinstance(o,GH.Kernel.Special.GH_NumberSlider)}
    cluster=next(o for o in document.Objects if isinstance(o,GH.Kernel.Special.GH_Cluster))
    cache={}
    def geometry(values):
        key=tuple(values[:8])
        if key in cache: return cache[key]
        for ident,v in zip(SLIDER_IDS,key): sliders[ident].SetSliderValue(Decimal(v))
        document.NewSolution(True)
        errors=list(cluster.RuntimeMessages(GH.Kernel.GH_RuntimeMessageLevel.Error))
        if errors: raise ValueError('Original generator error: '+'; '.join(str(e) for e in errors))
        output=[]
        for goo in cluster.Params.Output[0].VolatileData.AllData(True):
            g=unwrap(goo)
            if isinstance(g,rg.GeometryBase):
                if not g.IsValid: raise ValueError('Original generator produced invalid geometry')
                output.append(g.Duplicate())
        if not output: raise ValueError('Original support generator returned no geometry for '+str(key))
        cache[key]=output
        return output
    return document,geometry

# -*- coding: utf-8 -*-
# The build tool embeds layout_math.py above this code.
import Rhino.Geometry as rg
import rhinoscriptsyntax as rs
from Grasshopper import DataTree
from Grasshopper.Kernel.Data import GH_Path
from Grasshopper.Kernel import GH_RuntimeMessageLevel
from System import Object

Placed=DataTree[Object]()
Centers=[]; Frames=[]; Relief=[]; Rejected=[]; Report=''
IDs=[]; Labels=[]; Catalog=[]
generator_doc=None
def unwrap(g):
    if hasattr(g,'ScriptVariable'): g=g.ScriptVariable()
    if isinstance(g,rg.GeometryBase): return g
    return rs.coercegeometry(g)
def execute_layout():
    global Report, generator_doc
    mesh=unwrap(T)
    if not isinstance(mesh,rg.Mesh): raise ValueError('T must be a terrain mesh; use Mesh Brep for surfaces.')
    if not mesh.IsValid: raise ValueError('Terrain mesh is invalid')
    geo=[unwrap(g) for g in G]
    geo=[g for g in geo if g is not None]
    if not geo: raise ValueError('Connect the support Result output to G')
    mode=int(Mode); dx=float(DX); dy=float(DY); gap=float(Gap)
    maxrelief=float(MaxRelief); step=float(ContourStep); limit=int(MaxCount)
    margin=float(Margin); shift=float(Shift); angle=math.radians(float(Angle))
    if mode not in [0,1,2,3]: raise ValueError('Mode must be 0, 1, 2 or 3')
    if min(dx,dy,step,limit)&lt;=0 or min(gap,margin,maxrelief)&lt;0 or not 0&lt;=shift&lt;=1:
        raise ValueError('Check positive spacings/count and nonnegative clearances; Shift must be 0..1')
    bb=rg.BoundingBox.Empty
    for g in geo: bb.Union(g.GetBoundingBox(True))
    src=rg.Point3d(bb.Center.X,bb.Center.Y,bb.Min.Z)
    hx=(bb.Max.X-bb.Min.X)/2+margin; hy=(bb.Max.Y-bb.Min.Y)/2+margin
    if min(hx,hy)&lt;=0: raise ValueError('Support must have a nonzero XY footprint')
    radius=math.sqrt(hx*hx+hy*hy)
    vertices=[(float(p.X),float(p.Y),float(p.Z)) for p in mesh.Vertices]
    triangles=[]
    for f in mesh.Faces:
        triangles.append([vertices[f.A],vertices[f.B],vertices[f.C]])
        if f.IsQuad: triangles.append([vertices[f.A],vertices[f.C],vertices[f.D]])
    if not triangles: raise ValueError('Empty terrain')
    idx=TerrainIndex(triangles,max(dx,dy,2*radius))
    boundary=unwrap(Boundary) if Boundary is not None else None
    if boundary is not None:
        if not isinstance(boundary,rg.Curve) or not boundary.IsClosed: raise ValueError('Boundary must be a closed curve')
        boundary=rg.Curve.ProjectToPlane(boundary,rg.Plane.WorldXY)
    candidates=[]; contour_curves=[]
    fallback=False
    if mode==0:
        tb=mesh.GetBoundingBox(True)
        n=int(math.floor((tb.Max.Z-tb.Min.Z)/step))
        if n&gt;500: raise ValueError('More than 500 contours: increase ContourStep')
        for k in range(1,n+1):
            plane=rg.Plane(rg.Point3d(0,0,tb.Min.Z+k*step),rg.Vector3d.ZAxis)
            curves=rg.Mesh.CreateContourCurves(mesh,plane)
            for curve in curves:
                contour_curves.append(curve)
                ts=curve.DivideByLength(dx,True)
                if ts is None: ts=[curve.Domain.Mid]
                for j,t in enumerate(ts):
                    p=curve.PointAt(t); v=curve.TangentAt(t)
                    candidates.append((p.X,p.Y,math.atan2(v.Y,v.X),k,j))
                    if len(candidates)&gt;20000: raise ValueError('More than 20000 contour candidates')
    if mode in [1,2]:
        candidates=list(grid_candidates((idx.x0,idx.y0,idx.x1,idx.y1),dx,dy,angle,shift if mode==2 else 0))
    if mode==3:
        guide=unwrap(Guide) if Guide is not None else None
        if not isinstance(guide,rg.Curve):
            raise ValueError('Mode 3: draw/reference the gully centerline in Guide (Curve).')
        guide=rg.Curve.ProjectToPlane(guide,rg.Plane.WorldXY)
        if guide is None or not guide.IsValid or guide.GetLength()&lt;0.001:
            raise ValueError('Guide must have a valid nonzero XY projection')
        if guide.GetLength()/dx&gt;19999: raise ValueError('More than 20000 guide candidates: increase DX')
        ts=guide.DivideByLength(dx,True)
        if ts is None: ts=[guide.Domain.Mid]
        for j,t in enumerate(ts):
            p=guide.PointAt(t); v=guide.TangentAt(t)
            candidates.append((p.X,p.Y,math.atan2(v.Y,v.X),0,j))
    accepted=[]; footprints=[]; reasons={}; examined=0; truncated=False
    overrides=read_overrides(Overrides)
    known=set(); Catalog.append('ID,Radius,Depth,Openings,Height,Layer1,Layer2,Layer3,Layer4,Yaw,OffsetX,OffsetY,Gap,Enabled,Status')
    defaults=[float(v) for v in [DefaultRadius,DefaultDepth,DefaultOpenings,DefaultHeight,DefaultLayer1,DefaultLayer2,DefaultLayer3,DefaultLayer4]]+[0,0,0,gap,1]
    resolve_params(defaults,None)
    generator_doc,generate=create_generator()
    for x,y,yaw,row,col in candidates:
        if len(accepted)&gt;=limit: truncated=True; break
        examined+=1
        ident=support_id(mode,x,y,yaw); known.add(ident)
        values=resolve_params(defaults,overrides.get(ident))
        rowtext=ident+','+','.join(str(v) for v in values)
        if not values[12]:
            Catalog.append(rowtext+',disabled'); continue
        x+=values[9]; y+=values[10]; yaw+=math.radians(values[8]); gap=values[11]
        geo=generate(values)
        bb=rg.BoundingBox.Empty
        for g in geo: bb.Union(g.GetBoundingBox(True))
        src=rg.Point3d(bb.Center.X,bb.Center.Y,bb.Min.Z)
        hx=(bb.Max.X-bb.Min.X)/2+margin; hy=(bb.Max.Y-bb.Min.Y)/2+margin
        if min(hx,hy)&lt;=0: raise ValueError('Invalid support footprint: '+ident)
        radius=math.sqrt(hx*hx+hy*hy)
        reason=None
        co,si=math.cos(yaw),math.sin(yaw)
        footprint=[rg.Point3d(x+co*u-si*v,y+si*u+co*v,0) for u,v in [(-hx,-hy),(hx,-hy),(hx,hy),(-hx,hy),(-hx,-hy)]]
        if boundary:
            if any(boundary.Contains(p,rg.Plane.WorldXY,0.001)==rg.PointContainment.Outside for p in footprint[:-1]): reason='boundary'
            if reason is None:
                events=rg.Intersect.Intersection.CurveCurve(boundary,rg.PolylineCurve(footprint),0.001,0.001)
                if events and events.Count: reason='boundary'
        if reason is None and any(rectangles_overlap(footprint,f) for f in footprints): reason='overlap'
        if reason is None and mode==0 and any((x-a[0])**2+(y-a[1])**2 &lt; dy**2 for a in accepted): reason='spacing'
        hit=idx.footprint(x,y,yaw,hx,hy) if reason is None else None
        if reason is None and hit is None: reason='terrain edge or hole'
        if reason is None and hit[1]&gt;maxrelief: reason='relief limit'
        if reason:
            Catalog.append(rowtext+',rejected: '+reason)
            reasons[reason]=reasons.get(reason,0)+1
            h=idx.height(x,y)
            Rejected.append(rg.Point3d(x,y,h if h is not None else mesh.GetBoundingBox(True).Min.Z))
            continue
        target=rg.Point3d(x,y,hit[0]+gap)
        plane=rg.Plane(target,rg.Vector3d(co,si,0),rg.Vector3d(-si,co,0))
        transform=rg.Transform.PlaneToPlane(rg.Plane(src,rg.Vector3d.ZAxis),plane)
        path=GH_Path(len(accepted))
        for g in geo:
            copy=g.Duplicate()
            if not copy.Transform(transform): raise ValueError('Geometry transform failed')
            Placed.Add(copy,path)
        footprints.append(footprint); IDs.append(ident)
        Labels.append(rg.TextDot(ident,target)); Catalog.append(rowtext+',accepted')
        Centers.append(target); Frames.append(plane); Relief.append(hit[1]); accepted.append((x,y))
    Report=('Units: cm | Mode: {0} | Accepted: {1} | Examined: {2}/{3}\n'
            'Rejected: {4}\nAll layers horizontal; four layer parameters remain user-controlled.\n'
            'Base = source bounding-box minimum Z; highest terrain in footprint + Gap.\n'
            'Terrain coverage sampled 7x7; relief is a sampled estimate. Inspect narrow holes.\n'
            'No per-layer deformation, burial, or structural validation.').format(mode,len(accepted),examined,len(candidates),reasons)
    unused=set(overrides)-known
    if unused: Report+='\nUnused override IDs (layout changed or MaxCount reached): '+', '.join(sorted(unused))
    Report+='\nPer-support overrides active; original eight generator parameters preserved. Units: cm. Padded rectangle overlap checks.'
    if fallback: Report+='\nNo contours at this interval: used aligned grid.'
    if mode==0:
        Report+='\nFull terrain contours restored: no depression filter. No grid fallback.'
    if mode==3:
        Report+='\nGully guide: centers follow the supplied XY curve; DX is along-curve spacing. Heights come from terrain, not guide Z. Large footprints can bridge gully banks; narrow/steep sites can be rejected.'
    if truncated: Report+='\nMaxCount reached: output truncated; increase MaxCount for the full layout.'
    if not accepted: ghenv.Component.AddRuntimeMessage(GH_RuntimeMessageLevel.Warning,'No accepted modules; see Report and relax limits.')
try:
    execute_layout()
except Exception as ex:
    Placed=DataTree[Object](); Centers=[]; Frames=[]; Relief=[]; Rejected=[]
    IDs=[]; Labels=[]; Catalog=[]
    Report='ERROR: '+str(ex)
    ghenv.Component.AddRuntimeMessage(GH_RuntimeMessageLevel.Error,Report)

finally:
    if generator_doc is not None: generator_doc.Dispose()
