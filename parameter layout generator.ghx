            <chunk name="Object" index="11">
              <items count="2">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Name" type_name="gh_string" type_code="10">Python Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="7">
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">e9ac240c-0b14-4a70-9210-54a423526846</item>
                    <item name="Name" type_name="gh_string" type_code="10">Python Script</item>
                    <item name="NickName" type_name="gh_string" type_code="10">Terrain / embedded sample</item>
                    <item name="Description" type_name="gh_string" type_code="10">Terrain / embedded sample</item>
                    <item name="HideInput" type_name="gh_bool" type_code="1">true</item>
                    <item name="HideOutput" type_name="gh_bool" type_code="1">true</item>
                    <item name="CodeInput" type_name="gh_string" type_code="10">import Rhino.Geometry as rg
import rhinoscriptsyntax as rs
import base64, struct
TerrainMesh=rg.Mesh()
if T:
    for g in T:
        if hasattr(g,'ScriptVariable'): g=g.ScriptVariable()
        if not isinstance(g,rg.GeometryBase): g=rs.coercegeometry(g)
        if isinstance(g,rg.Mesh): TerrainMesh.Append(g)
        elif isinstance(g,rg.Brep):
            for m in rg.Mesh.CreateFromBrep(g,rg.MeshingParameters.Default): TerrainMesh.Append(m)
        elif isinstance(g,rg.Surface):
            for m in rg.Mesh.CreateFromBrep(g.ToBrep(),rg.MeshingParameters.Default): TerrainMesh.Append(m)
        else: raise ValueError('Terrain input accepts meshes, surfaces or Breps')
else:
    b=base64.b64decode('')
    n=struct.unpack_from('&lt;I',b,80)[0]
    for i in range(n):
        k=TerrainMesh.Vertices.Count
        for j in range(3):
            x,y,z=struct.unpack_from('&lt;3f',b,84+50*i+12+12*j)
            TerrainMesh.Vertices.Add(x,y,z)
        TerrainMesh.Faces.AddFace(k,k+1,k+2)
TerrainMesh.Vertices.CombineIdentical(True,True)
TerrainMesh.Normals.ComputeNormals()
TerrainMesh.Compact()
</item>
                  </items>
                  <chunks count="2">
                    <chunk name="Attributes">
                      <items count="2">
                        <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
