                    <item name="CodeInput" type_name="gh_string" type_code="10">"""Pure Python 2.7/3 compatible terrain placement mathematics. Units: cm."""
import math

def clip(poly, axis, limit, keep_greater):
    if not poly: return []
    out=[]
    a=poly[-1]
    ain=(a[axis]&gt;=limit) if keep_greater else (a[axis]&lt;=limit)
    for b in poly:
        bin=(b[axis]&gt;=limit) if keep_greater else (b[axis]&lt;=limit)
        if ain != bin:
            t=(limit-a[axis])/(b[axis]-a[axis])
            out.append(tuple(a[k]+t*(b[k]-a[k]) for k in range(3)))
        if bin: out.append(b)
        a,ain=b,bin
    return out

class TerrainIndex(object):
    def __init__(self, triangles, cell):
        if cell&lt;=0: raise ValueError('Index cell must be positive')
        self.triangles=triangles
        self.cell=cell
        self.bins={}
        self.x0=min(p[0] for t in triangles for p in t)
        self.y0=min(p[1] for t in triangles for p in t)
        self.x1=max(p[0] for t in triangles for p in t)
        self.y1=max(p[1] for t in triangles for p in t)
        for i,t in enumerate(triangles):
            for key in self.keys(min(p[0] for p in t),min(p[1] for p in t),max(p[0] for p in t),max(p[1] for p in t)):
                self.bins.setdefault(key,[]).append(i)
    def keys(self,x0,y0,x1,y1):
        for i in range(int(math.floor(x0/self.cell)),int(math.floor(x1/self.cell))+1):
            for j in range(int(math.floor(y0/self.cell)),int(math.floor(y1/self.cell))+1): yield (i,j)
    def height(self,x,y):
        z=None
        key=(int(math.floor(x/self.cell)),int(math.floor(y/self.cell)))
        for i in self.bins.get(key,[]):
            a,b,c=self.triangles[i]
            d=(b[1]-c[1])*(a[0]-c[0])+(c[0]-b[0])*(a[1]-c[1])
            if abs(d)&lt;1e-12: continue
            u=((b[1]-c[1])*(x-c[0])+(c[0]-b[0])*(y-c[1]))/d
            v=((c[1]-a[1])*(x-c[0])+(a[0]-c[0])*(y-c[1]))/d
            if u&gt;=-1e-9 and v&gt;=-1e-9 and u+v&lt;=1+1e-9:
                h=u*a[2]+v*b[2]+(1-u-v)*c[2]
                z=h if z is None else max(z,h)
        return z
    def footprint(self,x,y,yaw,hx,hy,n=7):
        co,si=math.cos(yaw),math.sin(yaw)
        samples=[]
        for i in range(n):
            for j in range(n):
                u=-hx+2*hx*i/(n-1); v=-hy+2*hy*j/(n-1)
                z=self.height(x+co*u-si*v,y+si*u+co*v)
                if z is None: return None
                samples.append(z)
        # Exact maximum on every projected triangle clipped to the footprint.
        rx=abs(co)*hx+abs(si)*hy; ry=abs(si)*hx+abs(co)*hy
        ids=set()
        for key in self.keys(x-rx,y-ry,x+rx,y+ry): ids.update(self.bins.get(key,[]))
        zmax=max(samples)
        for i in ids:
            poly=[(co*(p[0]-x)+si*(p[1]-y),-si*(p[0]-x)+co*(p[1]-y),p[2]) for p in self.triangles[i]]
            for ax,lim,greater in [(0,-hx,True),(0,hx,False),(1,-hy,True),(1,hy,False)]: poly=clip(poly,ax,lim,greater)
            if poly: zmax=max(zmax,max(p[2] for p in poly))
        relief=zmax-min(samples)
        return zmax, 0.0 if relief&lt;1e-8 else relief

    def depression(self,x,y,radius,samples=16):
        """Ring mean minus center: positive for bowls/valleys, zero on a plane.

        Require a full ring so a missing uphill/downhill side cannot bias the score.
        This is local concavity at the chosen scale, not hydrological basin depth.
        """
        if radius&lt;=0: raise ValueError('Depression radius must be positive')
        center=self.height(x,y)
        if center is None: return None
        heights=[]
        for i in range(samples):
            a=2*math.pi*i/samples
            h=self.height(x+radius*math.cos(a),y+radius*math.sin(a))
            if h is None: return None
            heights.append(h)
        return sum(heights)/samples-center

def grid_candidates(bounds,dx,dy,angle,stagger):
    co,si=math.cos(angle),math.sin(angle)
    x0,y0,x1,y1=bounds
    ox,oy=(x0+x1)/2,(y0+y1)/2
    pts=[(co*(x-ox)+si*(y-oy),-si*(x-ox)+co*(y-oy)) for x in [x0,x1] for y in [y0,y1]]
    u0,v0=min(p[0] for p in pts),min(p[1] for p in pts)
    u1,v1=max(p[0] for p in pts),max(p[1] for p in pts)
    nx=int(math.ceil((u1-u0)/dx)); ny=int(math.ceil((v1-v0)/dy))
    if (nx+1)*(ny+1)&gt;20000: raise ValueError('More than 20000 candidates: increase spacing')
    for row in range(ny+1):
        v=v0+row*dy
        for col in range(nx+1):
            u=u0+col*dx+(row%2)*stagger*dx
            yield (ox+co*u-si*v,oy+si*u+co*v,angle,row,col)

